# Strix Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
#
# Process: src/strix/config.py Settings.from_env() reads these at startup
# Effect: Configures all runtime behavior (DB, auth, logging, workers, OIDC, etc.)
# Security: NO secrets written here - all values are empty placeholders

# =============================================================================
# REQUIRED FOR PRODUCTION (ISHASTRA_ENV=production)
# =============================================================================
# Bootstrap admin API key (min 16 chars, no placeholders)
# Generate with: openssl rand -base64 32
ISHASTRA_API_KEY=

# Audit chain HMAC key (base64-encoded, min 16 chars decoded)
# Generate with: openssl rand -base64 32
ISHASTRA_AUDIT_HMAC_KEY=

# =============================================================================
# CORE SETTINGS
# =============================================================================
# Environment: development, test, staging, production
ISHASTRA_ENV=development

# Scope file path (global mode only)
ISHASTRA_SCOPE_FILE=scope.json

# Authorization mode: auto, global, managed
# - auto: managed if policies exist in DB, otherwise global
# - global: single organization, scope file required
# - managed: per-tenant engagement policies in database
ISHASTRA_SCOPE_MODE=auto

# Database: SQLite file path (default) or PostgreSQL DSN
# SQLite (dev/test): strix.db or :memory:
# PostgreSQL: postgresql://user:pass@host:5432/dbname
ISHASTRA_DB=strix.db

# PostgreSQL DSN (alternative to ISHASTRA_DB, takes precedence when set)
ISHASTRA_DATABASE_URL=

# Number of assessment workers (0 = disabled, runs inline)
ISHASTRA_WORKERS=1

# Maximum queued assessments per tenant
ISHASTRA_QUEUE_MAX=32

# CORS allowed origins (comma-separated)
ISHASTRA_CORS_ORIGINS=

# Trusted proxy IPs/CIDRs for X-Forwarded-For (comma-separated)
ISHASTRA_TRUSTED_PROXIES=

# Disable rate limiting (development only)
ISHASTRA_RATE_LIMIT_DISABLED=0

# Require Redis for distributed rate limiting
ISHASTRA_REDIS_REQUIRED=0

# Disable API docs (auto-enabled in production)
ISHASTRA_DISABLE_DOCS=0

# Enable debug mode
ISHASTRA_DEBUG=0

# =============================================================================
# SECURITY & AUDIT
# =============================================================================
# Max audit chain entries before rotation
ISHASTRA_AUDIT_MAX_ENTRIES=10000

# Webhook HMAC secret for alert signatures (min 16 chars)
ISHASTRA_WEBHOOK_SECRET=

# Encryption key for webhook secrets at rest (AES-GCM, 32 bytes base64)
# Generate with: openssl rand -base64 32
# If not set, webhook URLs stored in plaintext (NOT recommended for production)
ISHASTRA_ENCRYPTION_KEY=

# Retention: days after which finished jobs/findings are pruned
# 0 = disabled (never prune). Audit chain is ALWAYS kept.
ISHASTRA_RETENTION_DAYS=0

# Max request body size in bytes
ISHASTRA_MAX_BODY_BYTES=1048576

# Max JSON nesting depth
ISHASTRA_MAX_NESTING_DEPTH=10

# =============================================================================
# LOGGING
# =============================================================================
# Log format: text or json
ISHASTRA_LOG_FORMAT=text

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
ISHASTRA_LOG_LEVEL=INFO

# =============================================================================
# REDIS
# =============================================================================
# Redis connection URL
ISHASTRA_REDIS_URL=redis://localhost:6379/0

# =============================================================================
# WORKER RESOURCES
# =============================================================================
# Worker memory limit in MB (0 = disabled)
ISHASTRA_WORKER_MEMORY_MB=1024

# =============================================================================
# OIDC / SSO (Web UI)
# =============================================================================
# OIDC issuer URL (e.g., https://accounts.google.com)
ISHASTRA_OIDC_ISSUER=

# OIDC client ID
ISHASTRA_OIDC_CLIENT_ID=

# OIDC client secret (min 16 chars)
ISHASTRA_OIDC_CLIENT_SECRET=

# OIDC redirect URI (e.g., https://strix.example.com/auth/callback)
ISHASTRA_OIDC_REDIRECT_URI=

# OIDC scopes (space-separated)
ISHASTRA_OIDC_SCOPES=openid email profile

# Auto-provision users from OIDC claims
ISHASTRA_OIDC_AUTO_PROVISION=true

# Just-in-time authorization (optional). When set, ScopeGate.validate_outbound_async
# asks this endpoint after the local scope allows a target; anything but HTTP 200
# with {"result": {"allow": true}} denies the request.
ISHASTRA_SCOPE_JIT_URL=
# ASN / GeoIP tables for allowed_asns and allowed_countries (optional).
# JSON: {"asn": {"93.184.216.0/24": 15133}, "country": {"93.184.216.0/24": "US"}}
ISHASTRA_SCOPE_INTEL_FILE=

# =============================================================================
# EMAIL (organization invitations)
# =============================================================================
# Invitations are signed, expiring tokens delivered by SMTP. Without a host the
# API answers 503 and tells the caller to add the member directly.
ISHASTRA_SMTP_HOST=
ISHASTRA_SMTP_PORT=587
ISHASTRA_SMTP_USERNAME=
ISHASTRA_SMTP_PASSWORD=
# Envelope sender, e.g. "Strix <noreply@example.com>"
ISHASTRA_SMTP_FROM=
# STARTTLS on submit (587). Set to 0 only for a trusted local relay.
ISHASTRA_SMTP_STARTTLS=1
# Public URL used to build acceptance links in outgoing mail.
ISHASTRA_PUBLIC_BASE_URL=

# =============================================================================
# AI ANALYST (optional, advisory triage only)
# =============================================================================
# Any OpenAI-compatible endpoint: POST {base}/chat/completions
ISHASTRA_AI_BASE_URL=
ISHASTRA_AI_API_KEY=
ISHASTRA_AI_MODEL=gpt-4o-mini
ISHASTRA_AI_TIMEOUT=30
