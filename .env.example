# Copy to .env and export, or pass to your process manager / container runtime.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Required for authenticated API use; never leave this blank in production.
STRIX_API_KEY=
STRIX_SCOPE_FILE=/etc/strix/scope.json
STRIX_DB=/var/lib/strix/strix.db
# Authorization operating mode: global (single scope document), managed
# (per-tenant engagement policies via the /api/policies admin API), or auto
# (managed as soon as a policy exists in the database, global before that).
STRIX_SCOPE_MODE=auto
STRIX_WORKERS=1
STRIX_QUEUE_MAX=32
# PostgreSQL is experimental and unsupported for the threaded worker; keep SQLite.
# STRIX_DATABASE_URL=postgresql://strix:password@postgres:5432/strix
# STRIX_REDIS_REQUIRED=1
# STRIX_CORS_ORIGINS=https://dashboard.example.com
# Comma-separated CIDRs whose X-Forwarded-For header is trusted; the compose
# stack uses 172.28.0.0/24 for its nginx subnet.
# STRIX_TRUSTED_PROXIES=172.28.0.0/24
STRIX_LOG_LEVEL=INFO
# Generate a separate random key and store it outside the repository.
STRIX_AUDIT_HMAC_KEY=
# HMAC key that signs alert webhook deliveries (same generation command).
STRIX_WEBHOOK_SECRET=
# 0 keeps all history forever. A positive value prunes finished jobs/findings
# and plain audit entries older than that many days (chain is always kept).
STRIX_RETENTION_DAYS=0
# STRIX_MAX_BODY_BYTES=1048576
# STRIX_LOG_FORMAT=json
# STRIX_AUDIT_MAX_ENTRIES=10000
# 1 disables rate limits - local development only, never in production.
# STRIX_RATE_LIMIT_DISABLED=1
# Redis URL for rate limiting, caching, and distributed coordination.
# STRIX_REDIS_URL=redis://localhost:6379/0
