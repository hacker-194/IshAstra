# Ishastra Production Environment Configuration Template
# ====================================================
# Copy this file to .env.production and fill in ALL values
# Never commit .env.production to version control!
#
# Required secrets (generate with: scripts/generate-secrets.sh)

# Core API authentication (base64, 32+ bytes / 44+ chars)
# Used for API key authentication and request signing
ISHASTRA_API_KEY=

# HMAC key for audit log integrity verification (base64, 32+ bytes)
# Critical for tamper-evident audit trail
ISHASTRA_AUDIT_HMAC_KEY=

# AES-256-GCM key for secrets at rest (base64, exactly 32 bytes)
# Required by ISHASTRA_ENV=production; generate with: openssl rand -base64 32
ISHASTRA_ENCRYPTION_KEY=

# Webhook HMAC secret for verifying inbound webhook signatures (min 16 chars)
ISHASTRA_WEBHOOK_SECRET=

# Database & Scope Configuration
# -------------------------------
# SQLite database path (use postgresql://... for PostgreSQL)
ISHASTRA_DB=/var/lib/ishastra/ishastra.db

# Path to signed scope.json file (mounted from config/)
ISHASTRA_SCOPE_FILE=/etc/ishastra/scope.json

# Scope mode: auto (default) | global | managed
# auto: managed once policies exist, otherwise global
ISHASTRA_SCOPE_MODE=auto

# Worker & Queue Configuration
# -----------------------------
# Number of worker threads (inprocess mode only)
ISHASTRA_WORKERS=4

# Maximum queue size per worker
ISHASTRA_QUEUE_MAX=32

# Evidence retention period in days
ISHASTRA_RETENTION_DAYS=90

# Queue mode: inprocess (default) | redis-streams | k8s-jobs
ISHASTRA_QUEUE_MODE=inprocess

# Redis Configuration (required for redis-streams mode and multi-worker rate limiting)
# -----------------------------------------------
# Redis connection URL
ISHASTRA_REDIS_URL=redis://redis:6379/0

# Require Redis connection (1=yes, 0=no)
ISHASTRA_REDIS_REQUIRED=1

# PostgreSQL Configuration (optional, for multi-tenant production)
# -----------------------------------------------------------------
# ISHASTRA_DB=postgresql://ishastra:${ISHASTRA_DB_PASSWORD}@postgres:5432/ishastra
# ISHASTRA_DB_PASSWORD=

# Logging Configuration
# ---------------------
ISHASTRA_LOG_FORMAT=json
ISHASTRA_LOG_LEVEL=INFO
ISHASTRA_DEBUG=0

# CORS Configuration (if using separate dashboard origin)
# -------------------------------------------------------
# ISHASTRA_CORS_ORIGINS=https://dashboard.example.com

# Trusted Proxies (for correct client IP behind nginx/load balancer)
# -------------------------------------------------------------------
# Comma-separated CIDR ranges
ISHASTRA_TRUSTED_PROXIES=172.28.0.0/24

# Grafana Admin Password
# ----------------------
GRAFANA_PASSWORD=

# ============================================================================
# INTEGRATION SECRETS
# ============================================================================
# All secrets should be base64-encoded where noted.
# Generate with: scripts/generate-secrets.sh --integration

# Alertmanager / SMTP
# -------------------
SMTP_PASSWORD=
ALERTMANAGER_WEBHOOK_URL=

# Slack Integration
# -----------------
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_URL_CRITICAL=
SLACK_WEBHOOK_URL_SECURITY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Jira Integration
# ----------------
JIRA_API_TOKEN=
JIRA_BASE_URL=https://company.atlassian.net
JIRA_EMAIL=security@company.com

# GitHub Integration
# ------------------
GITHUB_TOKEN=
GITHUB_ACTIONS_TOKEN=
GITHUB_OWNER=myorg
GITHUB_REPO=security-tracking

# GitLab Integration
# ------------------
GITLAB_TOKEN=
GITLAB_CI_TOKEN=
GITLAB_BASE_URL=https://gitlab.com

# Microsoft Teams
# ---------------
TEAMS_WEBHOOK_URL=

# Mattermost
# ----------
MATTERMOST_WEBHOOK_URL=

# Splunk HEC
# ----------
SPLUNK_HEC_TOKEN=
SPLUNK_HOST=splunk.example.com
SPLUNK_PORT=8088

# Datadog
# -------
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# Elasticsearch / Elastic Cloud
# -----------------------------
ELASTIC_API_KEY=
ELASTIC_CLOUD_ID=
ELASTIC_PASSWORD=

# Azure Sentinel
# --------------
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ServiceNow
# ----------
SERVICENOW_PASSWORD=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_INSTANCE_URL=https://company.service-now.com

# PagerDuty
# ---------
PAGERDUTY_SERVICE_KEY=

# OpenTelemetry / Distributed Tracing
# -----------------------------------
OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Sentry Error Tracking
# ---------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# HashiCorp Vault
# ---------------
VAULT_TOKEN=
VAULT_ADDR=https://vault.example.com
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_NAMESPACE=security

# AWS Secrets Manager
# -------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ROLE_ARN=
AWS_KMS_KEY_ID=alias/ishastra-secrets

# Azure Key Vault
# ---------------
AZURE_KEYVAULT_URL=https://ishastra-secrets.vault.azure.net

# GCP Secret Manager
# ------------------
GCP_PROJECT_ID=my-gcp-project
GCP_CREDENTIALS_PATH=/path/to/service-account.json

# SMTP for Email Alerts
# ---------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alertmanager
SMTP_FROM=alertmanager@ishastra.example.com

# ============================================================================
# EXTERNAL SERVICE ENDPOINTS (configure per environment)
# ============================================================================

# Prometheus / Alertmanager
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093

# Loki / Tempo
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200

# Grafana
GRAFANA_URL=http://grafana:3000

# OIDC Configuration (for Web UI SSO)
# -----------------------------------
# OIDC Provider issuer URL (e.g., https://accounts.google.com, https://login.microsoftonline.com/tenant-id)
ISHASTRA_OIDC_ISSUER=
# OAuth client ID from your OIDC provider
ISHASTRA_OIDC_CLIENT_ID=
# OAuth client secret from your OIDC provider (min 16 chars)
ISHASTRA_OIDC_CLIENT_SECRET=
# Redirect URI after authentication (must match provider config exactly)
ISHASTRA_OIDC_REDIRECT_URI=
# Space-separated scopes (default: openid email profile)
ISHASTRA_OIDC_SCOPES=openid email profile
# Auto-provision tenant on first login (default: true)
ISHASTRA_OIDC_AUTO_PROVISION=true

# ============================================================================
# SECURITY / HARDENING SETTINGS
# ============================================================================

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Worker memory limit (MB)
ISHASTRA_WORKER_MEMORY_MB=2048

# ============================================================================
# DEVELOPMENT / DEBUG (disable in production)
# ============================================================================

# ISHASTRA_DEBUG=1
# ISHASTRA_LOG_LEVEL=DEBUG

# Just-in-time authorization (optional). When set, ScopeGate.validate_outbound_async
# asks this endpoint after the local scope allows a target; anything but HTTP 200
# with {"result": {"allow": true}} denies the request.
ISHASTRA_SCOPE_JIT_URL=
# ASN / GeoIP tables for allowed_asns and allowed_countries (optional).
# JSON: {"asn": {"93.184.216.0/24": 15133}, "country": {"93.184.216.0/24": "US"}}
ISHASTRA_SCOPE_INTEL_FILE=

# =============================================================================
# EMAIL (organization invitations)
# =============================================================================
# Invitations are signed, expiring tokens delivered by SMTP. Without a host the
# API answers 503 and tells the caller to add the member directly.
ISHASTRA_SMTP_HOST=
ISHASTRA_SMTP_PORT=587
ISHASTRA_SMTP_USERNAME=
ISHASTRA_SMTP_PASSWORD=
# Envelope sender, e.g. "Ishastra <noreply@example.com>"
ISHASTRA_SMTP_FROM=
# STARTTLS on submit (587). Set to 0 only for a trusted local relay.
ISHASTRA_SMTP_STARTTLS=1
# Public URL used to build acceptance links in outgoing mail.
ISHASTRA_PUBLIC_BASE_URL=

