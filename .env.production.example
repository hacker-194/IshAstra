# Strix Production Environment (Docker Compose)
# Copy to .env.production and fill in values

# Core secrets (generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))')
STRIX_API_KEY=
STRIX_AUDIT_HMAC_KEY=
STRIX_WEBHOOK_SECRET=

# Database & Scope
STRIX_DB=/var/lib/strix/strix.db
STRIX_SCOPE_FILE=/etc/strix/scope.json
STRIX_SCOPE_MODE=auto

# Worker & Retention
STRIX_WORKERS=1
STRIX_QUEUE_MAX=32
STRIX_RETENTION_DAYS=90

# Redis (required for multi-worker)
STRIX_REDIS_URL=redis://redis:6379/0
STRIX_REDIS_REQUIRED=1

# Logging
STRIX_LOG_FORMAT=json
STRIX_LOG_LEVEL=INFO

# CORS (if using separate dashboard origin)
# STRIX_CORS_ORIGINS=https://dashboard.example.com

# Trusted proxies (for correct client IP behind nginx)
STRIX_TRUSTED_PROXIES=172.18.0.1

# Nuclei (optional)
# STRIX_NUCLEI_TEMPLATES=/opt/nuclei-templates

# Grafana
GRAFANA_PASSWORD=