# Strix Staging Environment Configuration Template
# ================================================
# Copy this file to .env.staging and fill in values
# Used for pre-production validation environment
#
# Required secrets (generate with: scripts/generate-secrets.sh)
# -----------------------------------------------------------

# Core API authentication (base64, 32+ bytes / 44+ chars)
STRIX_API_KEY=

# HMAC key for audit log integrity verification (base64, 32+ bytes)
STRIX_AUDIT_HMAC_KEY=

# Webhook HMAC secret for verifying inbound webhook signatures (min 16 chars)
STRIX_WEBHOOK_SECRET=

# Database & Scope Configuration
# -------------------------------
STRIX_DB=/var/lib/strix/strix.db
STRIX_SCOPE_FILE=/etc/strix/scope.json
STRIX_SCOPE_MODE=auto

# Worker & Queue Configuration
# -----------------------------
STRIX_WORKERS=2
STRIX_QUEUE_MAX=16
STRIX_RETENTION_DAYS=30
STRIX_QUEUE_MODE=inprocess

# Redis Configuration
# -------------------
STRIX_REDIS_URL=redis://redis:6379/0
STRIX_REDIS_PASSWORD=
STRIX_REDIS_REQUIRED=1

# Celery Configuration (used when STRIX_QUEUE_MODE=celery)
# ---------------------------------------------------------
STRIX_CELERY_BROKER_URL=redis://redis:6379/1
STRIX_CELERY_RESULT_BACKEND=redis://redis:6379/2
STRIX_CELERY_MAX_TASKS_PER_CHILD=50
STRIX_CELERY_MAX_MEMORY_PER_CHILD=1073741824
STRIX_CELERY_TASK_TIME_LIMIT=3600
STRIX_CELERY_TASK_SOFT_TIME_LIMIT=300

# Logging Configuration
# ---------------------
STRIX_LOG_FORMAT=json
STRIX_LOG_LEVEL=DEBUG
STRIX_DEBUG=0

# CORS Configuration
# ------------------
STRIX_CORS_ORIGINS=https://staging-dashboard.example.com

# Trusted Proxies
# ---------------
STRIX_TRUSTED_PROXIES=172.28.0.0/24

# Nuclei Templates (optional)
# ----------------------------
# STRIX_NUCLEI_TEMPLATES=/opt/nuclei-templates

# Grafana Admin Password
# ----------------------
GRAFANA_PASSWORD=

# ============================================================================
# INTEGRATION SECRETS (Staging/Testing endpoints)
# ============================================================================

# Alertmanager / SMTP
SMTP_PASSWORD=
ALERTMANAGER_WEBHOOK_URL=https://alertmanager-staging.example.com/webhook

# Slack Integration (use test workspace)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<WORKSPACE_ID>/<CHANNEL_ID>/<TOKEN>
SLACK_WEBHOOK_URL_CRITICAL=
SLACK_WEBHOOK_URL_SECURITY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Jira Integration (use test project)
JIRA_API_TOKEN=
JIRA_BASE_URL=https://company-staging.atlassian.net
JIRA_EMAIL=security-staging@company.com

# GitHub Integration (use test repo)
GITHUB_TOKEN=
GITHUB_ACTIONS_TOKEN=
GITHUB_OWNER=myorg
GITHUB_REPO=security-tracking-staging

# GitLab Integration (use test project)
GITLAB_TOKEN=
GITLAB_CI_TOKEN=
GITLAB_BASE_URL=https://gitlab.com

# Microsoft Teams (use test channel)
TEAMS_WEBHOOK_URL=

# Mattermost
MATTERMOST_WEBHOOK_URL=

# Splunk HEC (use test index)
SPLUNK_HEC_TOKEN=
SPLUNK_HOST=splunk-staging.example.com
SPLUNK_PORT=8088

# Datadog (use test site)
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

# Elasticsearch (use test cluster)
ELASTIC_API_KEY=
ELASTIC_CLOUD_ID=
ELASTIC_PASSWORD=

# Azure Sentinel (use test workspace)
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ServiceNow (use test instance)
SERVICENOW_PASSWORD=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_INSTANCE_URL=https://company-staging.service-now.com

# PagerDuty (use test service)
PAGERDUTY_SERVICE_KEY=

# OpenTelemetry / Distributed Tracing
OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Sentry Error Tracking (use test project)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0

# HashiCorp Vault (use test namespace)
VAULT_TOKEN=
VAULT_ADDR=https://vault-staging.example.com
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_NAMESPACE=security-staging

# AWS Secrets Manager (use test account)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ROLE_ARN=
AWS_KMS_KEY_ID=alias/strix-secrets-staging

# Azure Key Vault (use test vault)
AZURE_KEYVAULT_URL=https://strix-secrets-staging.vault.azure.net

# GCP Secret Manager (use test project)
GCP_PROJECT_ID=staging-gcp-project
GCP_CREDENTIALS_PATH=/path/to/staging-service-account.json

# SMTP for Email Alerts (use test SMTP)
SMTP_HOST=smtp-staging.example.com
SMTP_PORT=587
SMTP_USERNAME=alertmanager-staging
SMTP_FROM=alertmanager@strix-staging.example.com

# ============================================================================
# EXTERNAL SERVICE ENDPOINTS
# ============================================================================

PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
GRAFANA_URL=http://grafana:3000

# OIDC Configuration (for Web UI SSO)
# -----------------------------------
STRIX_OIDC_ISSUER=
STRIX_OIDC_CLIENT_ID=
STRIX_OIDC_CLIENT_SECRET=
STRIX_OIDC_REDIRECT_URI=
STRIX_OIDC_SCOPES=openid email profile
STRIX_OIDC_AUTO_PROVISION=true

# ============================================================================
# SECURITY / HARDENING SETTINGS
# ============================================================================

STRIX_TLS_ENABLED=1
STRIX_TLS_CERT_PATH=/etc/letsencrypt/live/strix-staging.example.com/fullchain.pem
STRIX_TLS_KEY_PATH=/etc/letsencrypt/live/strix-staging.example.com/privkey.pem
STRIX_CERT_EMAIL=security-staging@example.com
STRIX_TLS_DOMAINS=strix-staging.example.com,api.strix-staging.example.com

# ============================================================================
# PERFORMANCE TUNING (reduced for staging)
# ============================================================================

STRIX_WORKER_MEMORY_MB=1024
STRIX_REQUEST_TIMEOUT=300
STRIX_MAX_CONCURRENT=5

# =============================================================================
# EMAIL (organization invitations)
# =============================================================================
# Invitations are signed, expiring tokens delivered by SMTP. Without a host the
# API answers 503 and tells the caller to add the member directly.
STRIX_SMTP_HOST=
STRIX_SMTP_PORT=587
STRIX_SMTP_USERNAME=
STRIX_SMTP_PASSWORD=
# Envelope sender, e.g. "Strix <noreply@example.com>"
STRIX_SMTP_FROM=
# STARTTLS on submit (587). Set to 0 only for a trusted local relay.
STRIX_SMTP_STARTTLS=1
# Public URL used to build acceptance links in outgoing mail.
STRIX_PUBLIC_BASE_URL=

# =============================================================================
# AI ANALYST (optional, advisory triage only)
# =============================================================================
# Any OpenAI-compatible endpoint: POST {base}/chat/completions
STRIX_AI_BASE_URL=
STRIX_AI_API_KEY=
STRIX_AI_MODEL=gpt-4o-mini
STRIX_AI_TIMEOUT=30
