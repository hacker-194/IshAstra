#!/usr/bin/env bash
# Hourly verified database backup. Install as e.g. /etc/cron.hourly/strix-backup.
#
# Writes one verified artifact per run (SQLite snapshot, or a pg_dump archive
# when ISHASTRA_DATABASE_URL points at PostgreSQL), then prunes old ones. A backup
# that fails verification makes this script exit non-zero, so the cron mail or
# your monitoring sees it instead of discovering it during a failover.
set -euo pipefail

ISHASTRA_BIN="${ISHASTRA_BIN:-ishastra}"
export ISHASTRA_DB="${ISHASTRA_DB:-/var/lib/strix/strix.db}"
backup_dir="${ISHASTRA_BACKUP_DIR:-/backups}"
retain_days="${ISHASTRA_BACKUP_RETAIN_DAYS:-14}"

mkdir -p "$backup_dir"

"$ISHASTRA_BIN" backup --out "$backup_dir"

# Keep the retention window; both artifacts are rotated by the same rule.
find "$backup_dir" -maxdepth 1 -type f \
  \( -name 'ishastra-*.db' -o -name 'ishastra-*.dump' \) \
  -mtime "+${retain_days}" -delete
