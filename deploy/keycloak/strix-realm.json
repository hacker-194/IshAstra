{
  "realm": "strix",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "strix-local",
      "name": "Strix local development",
      "enabled": true,
      "protocol": "openid-connect",
