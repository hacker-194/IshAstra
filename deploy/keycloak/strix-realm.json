      "username": "strix-local-user",
      "enabled": true,
      "email": "strix-local-user@example.local",
      "emailVerified": true,
      "firstName": "Strix",
      "lastName": "Local",
      "credentials": [
        {
          "type": "password",
          "value": "local-only-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    }
