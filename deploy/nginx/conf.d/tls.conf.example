# TLS vhost (not loaded while the filename ends in .example).
#
# For a Nepal deployment, serve client traffic over HTTPS:
#   1. Point the DNS name at this host.
#   2. Obtain a certificate (certbot, or the client's certificate):
#        certbot certonly --webroot -w /var/www/certbot -d strix.example.com.np
#   3. Mount ./certs (or /etc/letsencrypt) into the nginx container and rename
#      this file to tls.conf, replacing the paths and server_name below.
#   4. Add `- "443:443"` to the nginx service ports.
#   5. Uncomment the HTTP -> HTTPS redirect in strix.conf.
#
# Verify after enabling:
#   curl -sSI https://strix.example.com.np/api/health
#   openssl s_client -connect strix.example.com.np:443 -servername strix.example.com.np </dev/null 2>/dev/null | openssl x509 -noout -dates

server {
    listen 443 ssl http2;
    server_name strix.example.com.np;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass http://strix_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
