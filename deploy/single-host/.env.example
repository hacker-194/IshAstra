# Copy to .env and fill in. Never commit .env.
# Generate the three keys with: openssl rand -base64 48

# Public hostname Caddy serves (must resolve to this host). ":80" for HTTP only.
SITE_ADDRESS=assess.example.com

# Required by ISHASTRA_ENV=production; placeholder values are refused at startup.
ISHASTRA_API_KEY=
# Must be the same value the existing audit chain was sealed with, or the chain
# will not verify after a restore.
ISHASTRA_AUDIT_HMAC_KEY=
# Must be the same value existing encrypted values were written with.
ISHASTRA_ENCRYPTION_KEY=

# Adapter threads inside the single process.
ISHASTRA_WORKERS=2
ISHASTRA_LOG_LEVEL=INFO

# Optional: webhook for finished jobs (Slack/Teams/anything that takes JSON).
# Set ISHASTRA_NOTIFY_WEBHOOK_URL if you want job-finished notifications.
# Optional: HMAC-signs every webhook body with X-Strix-Signature.
# Set ISHASTRA_WEBHOOK_SECRET for HMAC signing.
# Oracle Cloud: no Fly auto-stop config needed — this stack keeps running.
