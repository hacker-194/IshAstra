{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ishastra.dev/schemas/scope-document/v2",
  "title": "Ishastra Scope Document",
  "description": "Authorization scope document for security assessments. Enforces default-deny policy with explicit allowlist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program",
    "authorized_by",
    "authorization_ref",
    "include",
    "version"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "Schema version. v1: legacy format. v2: adds revocation, metadata, and stricter validation."
    },
    "program": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Human-readable program/engagement name"
    },
    "authorized_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Name/title of the authorizing authority (e.g., CISO, Legal Counsel)"
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "External reference: contract number, ticket ID, email thread, or legal document reference"
    },
    "include": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^([A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?\\.)*[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?$|^\\*\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?(?:\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?)*$|^(([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?|([0-9a-fA-F:]+:+[0-9a-fA-F]*)?)(%[A-Za-z0-9]+)?$",
        "maxLength": 253
      },
      "description": "In-scope host patterns. Wildcards (*.domain.com) cover subdomains only. IP literals with CIDR allowed. IDNs must be punycode."
    },
    "exclude": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^([A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?\\.)*[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?$|^\\*\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?(?:\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?)*$|^(([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?|([0-9a-fA-F:]+:+[0-9a-fA-F]*)?)(%[A-Za-z0-9]+)?$",
        "maxLength": 253
      },
      "default": [],
      "description": "Out-of-scope host patterns. Takes precedence over include. Wildcards cover subdomains only."
    },
    "authorized_networks": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}|([0-9a-fA-F:]+:+[0-9a-fA-F]*)/[0-9]{1,3})$"
      },
      "default": [],
      "description": "Explicitly authorized internal networks (CIDR). Empty = deny all private/loopback/link-local. Networks broader than /8 require allow_broad_networks=true."
    },
    "allowed_ports": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "default": [],
      "description": "Allowed TCP/UDP service ports. Empty = all ports on in-scope hosts."
    },
    "allow_broad_networks": {
      "type": "boolean",
      "default": false,
      "description": "Allow authorized_networks broader than /8 (IPv4) or /8 (IPv6). Dangerous override; audit required."
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "users": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "cookies": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "domain": {
                      "type": "string",
                      "maxLength": 253
                    },
                    "path": {
                      "type": "string",
                      "maxLength": 256
                    }
                  }
                }
              },
              "headers": {
                "type": "object",
                "maxProperties": 50,
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "bearer": {
                "type": "string",
                "maxLength": 8192
              }
            }
          }
        }
      }
    },
    "collab": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "description": "Out-of-band canary listener for blind SSRF confirmation. Port 0 = in-process listener."
    },
    "revoked": {
      "type": "boolean",
      "default": false,
      "description": "If true, this scope document is revoked and must not be used for new assessments."
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the scope was revoked. Required if revoked=true."
    },
    "revoked_by": {
      "type": "string",
      "maxLength": 256,
      "description": "Identity of the party who revoked the scope. Required if revoked=true."
    },
    "revocation_reason": {
      "type": "string",
      "maxLength": 1024,
      "description": "Reason for revocation (e.g., 'engagement completed', 'scope changed', 'security incident')"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this scope document expires. After expiry, new assessments must not use this scope."
    },
    "metadata": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      },
      "description": "Arbitrary metadata for tooling, audit trails, and integrations. Not validated by the gate."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this authorization was signed (ISO 8601, with timezone). Signed with the document; a verifier refuses it once older than ISHASTRA_SCOPE_MAX_AGE_SECONDS."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "kid",
        "sig"
      ],
      "description": "Ed25519 signature over the canonical JSON of every other field. Required when a verification key set is configured.",
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sig": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "allowed_asns": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295
      },
      "default": [],
      "description": "Authorized AS numbers. Empty = no ASN policy. A policy set without a configured ASN lookup denies every address (fail closed)."
    },
    "allowed_countries": {
      "type": "array",
      "maxItems": 250,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2}$"
      },
      "default": [],
      "description": "Authorized ISO 3166-1 alpha-2 country codes (geo-fencing). Empty = no country policy. A policy set without a configured GeoIP lookup denies every address (fail closed)."
    },
    "rules_of_engagement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testing_hours": {
          "type": "string",
          "maxLength": 256,
          "description": "Authorized testing hours (e.g., '09:00-18:00 UTC, Mon-Fri'). Empty = no time restriction."
        },
        "rate_limit_rps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum requests per second per assessment. 0 = no limit."
        },
        "prohibited_techniques": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "default": [],
          "description": "List of prohibited testing techniques (e.g., 'DoS/DDoS attacks', 'Social engineering')."
        },
        "required_notifications": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "default": [],
          "description": "Events requiring notification to the authorizing authority."
        },
        "data_handling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pii_access": {
              "type": "string",
              "enum": ["prohibited", "restricted", "allowed"],
              "description": "PII access policy"
            },
            "credential_access": {
              "type": "string",
              "enum": ["prohibited", "restricted", "allowed"],
              "description": "Credential access policy"
            },
            "evidence_retention_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650,
              "description": "Days to retain evidence before secure deletion"
            },
            "report_delivery": {
              "type": "string",
              "maxLength": 256,
              "description": "Method for delivering reports (e.g., 'encrypted_email_or_portal')"
            }
          },
          "description": "Data handling requirements for the engagement"
        }
      },
      "description": "Rules of Engagement for the assessment. Empty = no RoE restrictions."
    }
  }
}
